<?xml version="1.0"?>
<registry>

    <!-- batch_actions.js uses selectedCheckBoxes (faceted-z3ctable) and submitFormHelper (imio-helpers) -->
    <records prefix="plone.bundles/collective.eeafaceted.batchactions"
        interface="plone.base.interfaces.IBundleRegistry">
        <value key="enabled">True</value>
        <value key="csscompilation">++resource++collective.eeafaceted.batchactions/batch_actions.css</value>
        <value key="jscompilation">++resource++collective.eeafaceted.batchactions/batch_actions.js</value>
        <value key="depends">plone,faceted-z3ctable,imio-helpers</value>
        <value key="load_async">False</value>
        <value key="load_defer">False</value>
    </records>

</registry>
